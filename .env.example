# Copy to .env and fill in. Never commit .env. Lines marked SECRET must stay private.
# Optional settings are commented out: leave them unset (not blank) to get the default shown.

# --- Required ---
# Postgres connection string. SECRET (contains the DB password).
DATABASE_URL=
# Redis connection string. SECRET if it contains a password.
REDIS_URL=
# Public https URL of the web app, e.g. https://dashboard.example.com
NEXTAUTH_URL=
# Session signing secret. SECRET. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=
# 32-byte key (base64) that encrypts stored WhatsApp tokens. SECRET. Generate: openssl rand -base64 32
# Back it up outside the server: without it, stored tokens cannot be decrypted.
ENCRYPTION_KEY=
# Meta app (Meta for Developers > your app > App settings > Basic)
META_APP_ID=
# SECRET. Checks X-Hub-Signature-256 on every webhook.
META_APP_SECRET=
# SECRET. You choose it; paste the same value into the Meta webhook setup.
META_VERIFY_TOKEN=

# The WhatsApp access token, WABA id and phone number id are NOT environment variables.
# Connect them in the app: Settings > Connect an account. The token is stored encrypted with ENCRYPTION_KEY.

# --- Docker (docker-compose.prod.yml) ---
# SECRET. Password for the bundled Postgres container.
POSTGRES_PASSWORD=
# PORT=                       # web server port inside the container; unset = 3100

# --- First Owner (npm run db:seed) ---
SEED_OWNER_EMAIL=
# SECRET
SEED_OWNER_PASSWORD=

# --- Optional ---
# PUBLIC_URL=                 # base for tracked links and invites; unset = NEXTAUTH_URL
# GOOGLE_CLIENT_ID=           # Google sign-in; unset hides the button
# GOOGLE_CLIENT_SECRET=       # SECRET
# GRAPH_API_VERSION=          # unset = v26.0
# GRAPH_BASE=                 # unset = https://graph.facebook.com
# PRICING_CURRENCY=           # unset = INR
# PRICING_RATES=              # JSON per-message rates, e.g. {"marketing":0.0,"utility":0.0}; unset = no cost estimate
# DEFAULT_COUNTRY_CODE=       # added to 10-digit CSV numbers; unset = 91
# STORAGE_DRIVER=             # local (default) or supabase
# MEDIA_DIR=                  # local media folder; unset = ../.data/media (compose sets /data/media)
# SUPABASE_URL=               # only with STORAGE_DRIVER=supabase
# SUPABASE_SERVICE_ROLE_KEY=  # SECRET, only with STORAGE_DRIVER=supabase
# SUPABASE_BUCKET=
# AI_REPLIES_ENABLED=         # 1 turns on the paid AI flow node; unset = off
# AI_MODEL=                   # unset = claude-opus-5-5
# ANTHROPIC_API_KEY=          # SECRET, only with AI replies on
# OUTBOUND_ALLOW_PRIVATE=     # local development only; never set in production
